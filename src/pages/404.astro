---
import Base from "../layouts/Base.astro";
---

<Base title="404: Page Not Found">
  <div class="notfound-card">
    <p class="notfound-code">404</p>
    <p class="notfound-msg">This page drifted away like Arctic sea ice.</p>
    <p>
      <a target="_self" href="/" class="notfound-home">&larr; Back to homepage</a>
    </p>
    <p class="notfound-jump">
      Or jump to:
      <a target="_self" href="/#-news">News</a> &middot;
      <a target="_self" href="/#-publications">Publications</a> &middot;
      <a target="_self" href="/#-visitor-map">Visitor Map</a>
    </p>
  </div>
</Base>
