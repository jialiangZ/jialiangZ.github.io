---
import Base from "../layouts/Base.astro";
---

<Base title="404: Page Not Found">
  <div style="text-align: center; padding: 4em 1em;">
    <p style="font-size: 5em; font-weight: 700; color: #2c3e50; margin: 0; line-height: 1;">404</p>
    <p style="font-size: 1.2em; color: #57606a; margin: 1em 0 2em;">This page drifted away like Arctic sea ice.</p>
    <p>
      <a target="_self" href="/" style="display: inline-block; padding: 8px 22px; background: #2c3e50; color: #fff; text-decoration: none; border-radius: 6px; font-size: 0.95em;">&larr; Back to homepage</a>
    </p>
    <p style="margin-top: 2.5em; color: #8b949e; font-size: 0.9em;">
      Or jump to:
      <a target="_self" href="/#-news">News</a> &middot;
      <a target="_self" href="/#-publications">Publications</a> &middot;
      <a target="_self" href="/#-visitor-map">Visitor Map</a>
    </p>
  </div>
</Base>
