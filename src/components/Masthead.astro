---
import { NAVIGATION } from "../config";
---

<div class="masthead">
  <div class="masthead__inner-wrap">
    <div class="masthead__menu">
      <nav id="site-nav" class="greedy-nav">
        <button><div class="navicon"></div></button>
        <ul class="visible-links">
          <li class="masthead__menu-item masthead__menu-item--lg masthead__menu-home-item"><a target="_self" href="#about-me">Homepage</a></li>
          {NAVIGATION.map((link) => (
            <li class="masthead__menu-item"><a target="_self" href={link.url}>{link.title}</a></li>
          ))}
        </ul>
        <ul class="hidden-links hidden"></ul>
      </nav>
    </div>
  </div>
</div>
