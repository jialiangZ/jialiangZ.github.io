---
import { NAVIGATION } from "../config";
---

<div class="masthead">
  <div class="masthead__inner-wrap">
    <div class="masthead__menu">
      <nav id="site-nav" class="greedy-nav">
        <button type="button" aria-label="More navigation links"><div class="navicon"></div></button>
        <ul class="visible-links">
          {NAVIGATION.map((link) => (
            <li class="masthead__menu-item"><a target="_self" href={link.url}>{link.title}</a></li>
          ))}
        </ul>
        <ul class="hidden-links hidden"></ul>
      </nav>
    </div>
  </div>
</div>

<script is:inline>
  // Capture-phase handler: fires before the legacy jQuery smoothScroll
  // plugin ($("a").smoothScroll({offset:-20}) in main.min.js) which binds
  // directly on each <a>. stopPropagation() keeps its animated scroll
  // from overriding this exact position.
  document.addEventListener("click", function (event) {
    if (!(event.target instanceof Element)) return;
    var link = event.target.closest("a");
    if (!link || !link.closest("#site-nav")) return;
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    var url = new URL(link.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || url.search !== location.search || !url.hash) return;
    var target = document.getElementById(url.hash.slice(1));
    if (!target) return;
    event.preventDefault();
    event.stopPropagation();
    var masthead = document.querySelector(".masthead");
    var head = target.nextElementSibling || target;
    var y = head.getBoundingClientRect().top + window.pageYOffset - ((masthead ? masthead.offsetHeight : 0) + 8);
    window.scrollTo({ top: Math.max(0, y), behavior: "auto" });
    if (location.hash !== url.hash) history.pushState(null, "", url.hash);
    document.querySelector("#site-nav .hidden-links").classList.add("hidden");
  }, true);
</script>
