---
import { Image } from "astro:assets";

interface Props {
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  loading?: "eager" | "lazy";
  title: string;
  arxiv: string;
  venue: string;
  authors: string;
  selfHighlight: string;
  scholarId: string;
}
const { image, imageAlt, imageWidth, imageHeight, loading = "lazy", title, arxiv, venue, authors, selfHighlight, scholarId } = Astro.props;
const authorList = authors.split(", ").map((a) => (a === selfHighlight ? { name: a, self: true } : { name: a, self: false }));
---

<div class="paper-box">
  <div class="paper-box-image">
    <Image src={image.startsWith("/") ? image : "/" + image} alt={imageAlt} width={imageWidth} height={imageHeight} loading={loading} decoding="async" />
  </div>
  <div class="paper-box-text">
    <p class="paper-title"><a href={arxiv}>{title}</a></p>
    <div class="paper-meta">
      <span class="paper-venue">{venue}</span>
      <a class="paper-arxiv" href={arxiv}>arXiv</a>
      <span class="paper-citations"><span class="show_paper_citations" data={scholarId} data-title={title}></span></span>
    </div>
    <p class="paper-authors">
      {authorList.map((a, i) => (
        <>
          {i > 0 && ", "}
          {a.self ? <strong>{a.name}</strong> : a.name}
        </>
      ))}
    </p>
  </div>
</div>
