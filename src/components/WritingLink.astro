---
import { WRITING_SITE } from "../config";
---

<a class="writing-card" href={WRITING_SITE.url} target="_self">
  <span class="writing-card__top">
    <span class="writing-card__label">
      <i class="fas fa-pen-nib" aria-hidden="true"></i>
      {WRITING_SITE.label}
    </span>
    <i class="fas fa-arrow-right writing-card__arrow" aria-hidden="true"></i>
  </span>

  <span class="writing-card__title">{WRITING_SITE.title}</span>
  <span class="writing-card__note">{WRITING_SITE.note}</span>
</a>
